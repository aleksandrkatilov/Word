<Project Sdk="Microsoft.NET.Sdk">
  <!-- Лаборатория для CI на Windows: проверки собственного ядра на эталонах и корпусе (AC-02, AC-06),
       проверка зависимостей (AC-07), UI-прогоны готового Pero.exe со скриншотами (AC-01, AC-03…AC-05). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pero-lab</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- FlaUI — MIT, только для автоматических UI-проверок, в приложение не входит. -->
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Pero.Core\Pero.Core.csproj" />
    <ProjectReference Include="..\..\src\Pero.Doc\Pero.Doc.csproj" />
  </ItemGroup>
</Project>
