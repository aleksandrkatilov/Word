<Project Sdk="Microsoft.NET.Sdk">
  <!-- Лаборатория для CI на Windows: разведка API движка, круговой обмен на SfRichTextBoxAdv,
       замеры производительности, UI-прогоны готового Pero.exe со скриншотами. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pero-lab</AssemblyName>
    <SyncfusionVersion>35.1.43</SyncfusionVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Syncfusion.SfRichTextRibbon.WPF" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.Licensing" Version="$(SyncfusionVersion)" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Pero.Core\Pero.Core.csproj" />
  </ItemGroup>
</Project>
