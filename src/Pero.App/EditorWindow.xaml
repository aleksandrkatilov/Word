<syncfusion:RibbonWindow x:Class="Pero.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        Width="1280" Height="820" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Лента в стиле Word берёт команды у редактора через DataContext. -->
        <syncfusion:SfRichTextRibbon x:Name="Ribbon" Grid.Row="0"
                                     SnapsToDevicePixels="True"
                                     DataContext="{Binding ElementName=Editor}"/>

        <!-- Панель сообщений (как жёлтая полоса Word): только чтение, восстановление, частичная поддержка. -->
        <Border x:Name="MessageBar" Grid.Row="1" Visibility="Collapsed"
                Background="#FFF4CE" BorderBrush="#E8DCA0" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕" Width="28" Margin="8,0,0,0"
                        Background="Transparent" BorderThickness="0" Click="CloseMessageBar_Click"
                        AutomationProperties.Name="Закрыть сообщение"/>
                <Button x:Name="MessageBarCopyButton" DockPanel.Dock="Right" Padding="10,2" Margin="8,0,0,0"
                        Click="SaveCopy_Click"/>
                <Button x:Name="MessageBarDetailsButton" DockPanel.Dock="Right" Padding="10,2" Margin="8,0,0,0"
                        Click="ShowReport_Click"/>
                <TextBlock x:Name="MessageBarText" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Документный движок с настоящей постраничной разметкой (PAGE-01). -->
        <syncfusion:SfRichTextBoxAdv x:Name="Editor" Grid.Row="2"
                                     LayoutType="Pages"
                                     Background="#E9E9E9"
                                     AutomationProperties.Name="Документ"/>

        <!-- Строка состояния (UI-06). -->
        <Border Grid.Row="3" Background="#F3F3F3" BorderBrush="#DADADA" BorderThickness="0,1,0,0" Padding="10,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PageStatus" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <TextBlock x:Name="WordStatus" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <TextBlock x:Name="LanguageStatus" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <Menu Grid.Column="3" Background="Transparent" VerticalAlignment="Center">
                    <MenuItem x:Name="Stage0Menu" Padding="6,1">
                        <MenuItem x:Name="MenuExportPdf" Click="ExportPdf_Click"/>
                        <MenuItem x:Name="MenuExportTxt" Click="ExportTxt_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MenuReport" Click="ShowReport_Click"/>
                        <MenuItem x:Name="MenuRoundTrip" Click="RoundTrip_Click"/>
                        <Separator/>
                        <MenuItem x:Name="RecentMenu" SubmenuOpened="RecentMenu_SubmenuOpened"/>
                    </MenuItem>
                </Menu>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="−" Width="24" Background="Transparent" BorderThickness="0"
                            Click="ZoomOut_Click" AutomationProperties.Name="Уменьшить масштаб"/>
                    <Slider x:Name="ZoomSlider" Width="120" Minimum="25" Maximum="500" VerticalAlignment="Center"
                            IsSnapToTickEnabled="False" SmallChange="10" LargeChange="10"
                            Value="{Binding ZoomFactor, ElementName=Editor, Mode=TwoWay}"
                            AutomationProperties.Name="Масштаб"/>
                    <Button Content="+" Width="24" Background="Transparent" BorderThickness="0"
                            Click="ZoomIn_Click" AutomationProperties.Name="Увеличить масштаб"/>
                    <TextBlock Width="44" TextAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding Value, ElementName=ZoomSlider, StringFormat={}{0:0}%}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</syncfusion:RibbonWindow>
