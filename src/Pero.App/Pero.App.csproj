<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pero</RootNamespace>
    <AssemblyName>Pero</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Перо</Product>
    <Version>0.3.0</Version>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Собственное ядро: модель, правка, разметка, DOCX, PDF. Сторонних редакторских SDK нет (AC-07). -->
  <ItemGroup>
    <ProjectReference Include="..\Pero.Core\Pero.Core.csproj" />
    <ProjectReference Include="..\Pero.Doc\Pero.Doc.csproj" />
  </ItemGroup>
</Project>
