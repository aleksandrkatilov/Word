<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pero</RootNamespace>
    <AssemblyName>RWrite</AssemblyName>
    <ApplicationIcon>Assets\rilvo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>RWrite</Product>
    <AssemblyTitle>RWrite</AssemblyTitle>
    <Company>Aleksandr Katilov</Company>
    <Version>0.3.0</Version>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\rilvo.ico" />
    <Resource Include="Assets\rilvo-256.png" />
    <Resource Include="Assets\rilvo-64.png" />
  </ItemGroup>

  <!-- Собственное ядро: модель, правка, разметка, DOCX, PDF. Сторонних редакторских SDK нет (AC-07). -->
  <ItemGroup>
    <ProjectReference Include="..\Pero.Core\Pero.Core.csproj" />
    <ProjectReference Include="..\Pero.Doc\Pero.Doc.csproj" />
  </ItemGroup>
</Project>
