<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pero</RootNamespace>
    <AssemblyName>Pero</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Перо</Product>
    <Version>0.1.0</Version>
    <!-- Строки локализации движка лежат в Resources\*.resx; генератор классов не нужен. -->
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <SyncfusionVersion>35.1.43</SyncfusionVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Лента в стиле Word + редактор SfRichTextBoxAdv + DocIO (тянется зависимостью). -->
    <PackageReference Include="Syncfusion.SfRichTextRibbon.WPF" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.Licensing" Version="$(SyncfusionVersion)" />
    <!-- Экспорт PDF через DocIO. -->
    <PackageReference Include="Syncfusion.DocToPDFConverter.WPF" Version="$(SyncfusionVersion)" />
    <!-- Светлая тема, близкая к Word из Microsoft 365 (визуальный ориентир ТЗ). -->
    <PackageReference Include="Syncfusion.SfSkinManager.WPF" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.Themes.Windows11Light.WPF" Version="$(SyncfusionVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pero.Core\Pero.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\make_ru_resx.py" />
    <EmbeddedResource Update="Resources\*.resx">
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>
</Project>
